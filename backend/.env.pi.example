# Kip on a Raspberry Pi 4 (8 GB): Ollama with one small Qwen model and the compact prompt.
# Copy to .env. See "Running on a Raspberry Pi 4" in the README.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# `ollama pull qwen3.5:2b-q4_K_M`: 4-bit, 1.3 GB of weights (+0.7 GB vision part Kip never uses). The
# plain `qwen3.5:2b` tag is 8-bit and twice the weights, so about half the speed on a Pi.
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Keep the model in memory: reloading ~2 GB from a microSD card takes tens of seconds.
OLLAMA_KEEP_ALIVE=-1
# A smaller context needs less memory and is quicker to set up per call.
CONTEXT_TOKENS=4096
# The same character, rules and action line in about a third of the size; Groq gets it too.
PROMPT_PROFILE=compact
# Recent conversation each reply carries. Less is faster on a Pi; more remembers the thread better.
COMPACT_HISTORY_TOKENS=250
CHAT_MAX_TOKENS=300
# A 2B model's own errands can be nonsense: when it writes the reply, keep its memories but start
# errands only from your own words (tool requests, live questions, a yes to an offer).
LOCAL_CHAT_ERRANDS=false
LLM_TIMEOUT_SECONDS=600
DIGITAL_TOOLS_ENABLED=true
# A Pi's clock is often UTC: Kip still speaks IST. Change if you live elsewhere.
TIMEZONE=Asia/Kolkata
# Optional: Groq answers while it has quota (web search, faster replies), the Pi when it cannot.
GROQ_API_KEY=
# Optional: CricketData.org key for cricket (100 requests a day free); ESPN answers without it.
CRICKETDATA_API_KEY=
# Optional: keep Kip's database on a USB 3 SSD rather than the microSD card.
# MEMORY_DB_FILE=/mnt/ssd/kip/kip.db
