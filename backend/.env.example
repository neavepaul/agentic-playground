# Kip on a Raspberry Pi 4 (8 GB). Copy to .env; every setting below is optional.
# Install Ollama and pull the model first: ollama pull qwen3.5:2b-q4_K_M

# Groq answers first while it has quota (replies in about a second, web search); the Pi's own
# model takes over when it cannot. Leave empty to stay fully on the Pi.
GROQ_API_KEY=
# CricketData.org key for cricket (100 requests a day free); ESPN answers without it.
CRICKETDATA_API_KEY=
# football-data.org key for football (10 requests a minute free); ESPN answers without it.
FOOTBALLDATA_API_KEY=
# Groww Trade API TOTP key and its TOTP secret, for "how is my portfolio doing" (read-only).
GROWW_API_KEY=
GROWW_API_SECRET=

# Defaults, shown so you know what to change:
# OLLAMA_MODEL=qwen3.5:2b-q4_K_M      # 4-bit; the plain qwen3.5:2b tag is 8-bit, about half the speed
# OLLAMA_KEEP_ALIVE=-1                # keep the model loaded: reloading from microSD takes tens of seconds
# CONTEXT_TOKENS=4096
# CHAT_HISTORY_TOKENS=800             # recent conversation each reply carries; less is faster
# CHAT_COMPACTION=true                # fold older turns of a long chat into a short note (one background call)
# CHAT_CHECKPOINT_TOKENS=200          # the most that note may take
# CHAT_MAX_TOKENS=300
# LOCAL_CHAT_ERRANDS=false            # the Pi's model talks and remembers; errands start from your words
# TIMEZONE=Asia/Kolkata               # every time Kip says, whatever the Pi's clock is set to
# GROQ_MAX_WAIT_SECONDS=20            # wait this long for a rate-limited Groq model before going local
# MEMORY_DB_FILE=/mnt/ssd/kip/kip.db  # keep Kip's database on a USB 3 SSD rather than the microSD card
