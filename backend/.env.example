LLM_PROVIDER=colibri
COLIBRI_BASE_URL=http://127.0.0.1:8001/v1
COLIBRI_MODEL=qwen3.6-colibri
DECISION_THINKING=false
# Public web search/reading and restricted small Python programs.
DIGITAL_TOOLS_ENABLED=true
# Optional hosted Groq for goal planning and web-research tasks (bounded; Colibri
# carries on whenever Groq cannot serve). Leave empty to stay fully local.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# When every Groq model is rate-limited for at most this long, wait rather than go local.
# GROQ_MAX_WAIT_SECONDS=20
# Optional CricketData.org key: cricket results and fixtures for a week or more either side
# (100 requests a day free). Without it, ESPN's scoreboard (a few days) answers cricket.
# CRICKETDATA_API_KEY=
# Optional alternative: set LLM_PROVIDER=ollama to use these settings.
# On a Raspberry Pi, start from .env.pi.example instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_KEEP_ALIVE=-1
# Smaller prompts for small local models (Groq gets the same): full or compact.
# PROMPT_PROFILE=compact
# COMPACT_HISTORY_TOKENS=600
LLM_TIMEOUT_SECONDS=600
TASK_TIMEOUT_SECONDS=1800
TEMPERATURE=0.1
CONTEXT_TOKENS=8192
MAX_COORDINATOR_CYCLES=20
# Hard safety ceiling per delegation, not the normal way one ends. Healthy work
# stops on completion or blockage well before this.
MAX_EXPLORER_ACTIONS=40
MAX_TOOL_CALLS=80
MAX_CRITIC_REVIEWS=8
LOG_LEVEL=INFO
# Kip's timezone for every time he says, whatever the device clock (IST by default).
# TIMEZONE=Asia/Kolkata

