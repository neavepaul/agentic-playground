LLM_PROVIDER=colibri
COLIBRI_BASE_URL=http://127.0.0.1:8001/v1
COLIBRI_MODEL=qwen3.6-colibri
DECISION_THINKING=false
# Public web search/reading and restricted small Python programs.
DIGITAL_TOOLS_ENABLED=true
# Goal interpretation already plans the outcomes; delegate them without a second call.
DIRECT_INITIAL_DELEGATION=true
# Idle intention generation can block user tasks on a slow model.
# Set true to enable autonomous background reflection again.
IDLE_REFLECTION_ENABLED=false
# Optional hosted Groq for goal planning and web-research tasks (bounded; Colibri
# carries on whenever Groq cannot serve). Leave empty to stay fully local.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Optional alternative: set LLM_PROVIDER=ollama to use these settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Optional absolute JSON path. Omit to use backend/worlds/house.json.
# WORLD_FILE=C:/path/to/my_house.json
LLM_TIMEOUT_SECONDS=600
TASK_TIMEOUT_SECONDS=1800
TEMPERATURE=0.1
CONTEXT_TOKENS=8192
MAX_COORDINATOR_CYCLES=20
# Hard safety ceiling per delegation, not the normal way one ends. Healthy work
# stops on completion, blockage or semantic stall well before this.
MAX_EXPLORER_ACTIONS=40
MAX_TOOL_CALLS=80
MAX_CRITIC_REVIEWS=8
# Physical actions yielding no semantic progress before the strategy is replanned.
MAX_SEMANTIC_STALL=3
# Actions after which a room scan goes stale and the room is worth rechecking.
SEARCH_STALE_AFTER=12
LOG_LEVEL=INFO

# realtime: the world advances with wall-clock time, so slow inference costs
#   simulated minutes. action_driven: the world advances only on successful
#   robot actions, making runs reproducible and comparable across models.
SIMULATION_MODE=realtime
CLOCK_SPEED=60
CLOCK_START_HOUR=8
# Simulated seconds granted per action in action_driven mode.
ACTION_SECONDS=60
